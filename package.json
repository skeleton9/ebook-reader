{
  "name": "between-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs --dev\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/start.mjs",
    "test": "vitest run",
    "format": "prettier --write src server scripts *.json *.ts *.html"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^11.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
