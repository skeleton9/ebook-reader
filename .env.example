# Production server port (npm start).
PORT=5173
# API server port for npm run dev; Vite reads the same value for its proxy.
DEV_API_PORT=3001

# OpenAI-compatible text generation service. Secrets stay on the server.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=

# Doubao Voice console API Key; independent from the Ark text model key.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_FEMALE_VOICE=zh_female_vv_uranus_bigtts
DOUBAO_TTS_MALE_VOICE=zh_male_m191_uranus_bigtts
